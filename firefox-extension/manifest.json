{
  "manifest_version": 3,
  "name": "Otosuでダウンロード",
  "version": "1.0.0",
  "description": "YouTubeの動画やプレイリストをOtosuへ共有します。",
  "permissions": ["activeTab", "menus"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Otosuでダウンロード"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "share@otosu.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
